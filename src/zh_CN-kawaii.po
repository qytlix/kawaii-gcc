#: cif-code.def:39
msgid "function not considered for inlining"
msgstr "我才不会考虑内联函数喵~(快放弃传统inline啊笨蛋！)"

#: cif-code.def:43
msgid "caller is not optimized"
msgstr "调用方未被优化啦！长点心吧喂！！！"

#: cif-code.def:47
msgid "function body not available"
msgstr "函数体不可用，你不知道吗！"

#: cif-code.def:51
msgid "redefined extern inline functions are not considered for inlining"
msgstr "不考虑内联重定义的外部内联函数啦"

#: cif-code.def:56
msgid "function not inlinable"
msgstr "函数不能内联的哦"

#: cif-code.def:60
msgid "function body can be overwritten at link time"
msgstr "函数体可能在链接时被覆盖"

#: cif-code.def:64
msgid "function not inline candidate"
msgstr "函数不是内联备选喵～再检查一下吧！"

#: cif-code.def:68
msgid "--param large-function-growth limit reached"
msgstr "已经到达 --param large-function-growth 给定的极限了，不能再多了！"

#: cif-code.def:70
msgid "--param large-stack-frame-growth limit reached"
msgstr "已经到达 --param large-stack-frame-growth 给定的极限了，不能再多了！"

#: cif-code.def:72
msgid "--param max-inline-insns-single limit reached"
msgstr "已经到达 --param max-inline-insns-single 给定的极限了，不能再多了！"

#: cif-code.def:74
msgid "--param max-inline-insns-auto limit reached"
msgstr "已经到达 --param max-inline-insns-single 给定的极限了，不能再多了！"

#: cif-code.def:76
msgid "--param inline-unit-growth limit reached"
msgstr "已经到达 --param inline-unit-growth 给定的极限了，不能再多了！"

#: cif-code.def:80
msgid "recursive inlining"
msgstr "套娃内联"

#: cif-code.def:84
msgid "call is unlikely and code size would grow"
msgstr "明明这种姿势..不太可能啦！还会让我坏掉的！"

#: cif-code.def:88
msgid "call is considered never executed and code size would grow"
msgstr "明明这种姿势..不太可能啦！还会让我坏掉的！"

#: cif-code.def:92
msgid "function not declared inline and code size would grow"
msgstr "喂！事先不告诉我这个函数还想偷偷进入吗？！而且...而且会坏掉的..."

#: cif-code.def:96
msgid "mismatched declarations during linktime optimization"
msgstr "需要迭代声明或初始化呢，建议检查下代码呢～"

#: cif-code.def:100
msgid "variadic thunk call"
msgstr "可变参数 Thunk 调用"

#: cif-code.def:104
msgid "originally indirect function call not considered for inlining"
msgstr "原本间接的函数调用不被考虑内联喵~"

#: cif-code.def:108
msgid "indirect function call with a yet undetermined callee"
msgstr "间接函数调用目标未定义喵～再检查一下吧！"

#: cif-code.def:112
msgid "exception handling personality mismatch"
msgstr "异常处理被触发了喵~"

#: cif-code.def:117
msgid "non-call exception handling mismatch"
msgstr "异常处理被触发了喵~"

#: cif-code.def:121
msgid "target specific option mismatch"
msgstr "切...挂羊头卖狗肉的混蛋！"

#: cif-code.def:125
msgid "optimization level attribute mismatch"
msgstr "优化等级属性不匹配呢笨蛋！"

#: cif-code.def:129
msgid "callee refers to comdat-local symbols"
msgstr "comdat 本地符号：'又在想我了喵~'"

#: cif-code.def:134
msgid "sanitizer function attribute mismatch"
msgstr "喂！难道...又忘记了我喜欢什么了嘛？！"

#: cif-code.def:149
msgid "unreachable"
msgstr "够不到~"

